{
  "name": "anydiff",
  "displayName": "AnyDiff",
  "description": "Compare anything: files, selections, clipboard, manual input and Git versions.",
  "version": "0.2.0",
  "publisher": "anydiff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anydiff/anydiff.git"
  },
  "bugs": {
    "url": "https://github.com/anydiff/anydiff/issues"
  },
  "homepage": "https://github.com/anydiff/anydiff#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "diff",
    "compare",
    "clipboard",
    "selection",
    "git",
    "json",
    "multi-way"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "anydiff.compareFiles",
        "title": "%anydiff.command.compareFiles%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareMultipleFiles",
        "title": "%anydiff.command.compareMultipleFiles%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareFileWithActive",
        "title": "%anydiff.command.compareFileWithActive%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareSelectedWithClipboard",
        "title": "%anydiff.command.compareSelectedWithClipboard%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareSelectedWithFile",
        "title": "%anydiff.command.compareSelectedWithFile%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareSelectedWithInput",
        "title": "%anydiff.command.compareSelectedWithInput%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareSelectionWithSelection",
        "title": "%anydiff.command.compareSelectionWithSelection%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareClipboardWithFile",
        "title": "%anydiff.command.compareClipboardWithFile%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareJsonSemantic",
        "title": "%anydiff.command.compareJsonSemantic%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareJsonWithActive",
        "title": "%anydiff.command.compareJsonWithActive%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.showClipboardHistory",
        "title": "%anydiff.command.showClipboardHistory%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareWithGitHead",
        "title": "%anydiff.command.compareWithGitHead%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.compareGitRevisions",
        "title": "%anydiff.command.compareGitRevisions%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.showRecent",
        "title": "%anydiff.command.showRecent%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.exportPatch",
        "title": "%anydiff.command.exportPatch%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.openMultiDiffPanel",
        "title": "%anydiff.command.openMultiDiffPanel%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.saveSession",
        "title": "%anydiff.command.saveSession%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.openSession",
        "title": "%anydiff.command.openSession%",
        "category": "%anydiff.command.category%"
      },
      {
        "command": "anydiff.about",
        "title": "%anydiff.command.about%",
        "category": "%anydiff.command.category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "anydiff.exportPatch",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "anydiff.exportPatch",
          "when": "isInDiffEditor",
          "group": "navigation@100"
        },
        {
          "command": "anydiff.saveSession",
          "when": "activeWebviewPanelId == anydiff.multiDiffPanel",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "anydiff.compareSelectedWithClipboard",
          "when": "editorTextFocus && editorHasSelection",
          "group": "2_anydiff@1"
        },
        {
          "command": "anydiff.compareSelectedWithFile",
          "when": "editorTextFocus && editorHasSelection",
          "group": "2_anydiff@2"
        },
        {
          "command": "anydiff.compareSelectedWithInput",
          "when": "editorTextFocus && editorHasSelection",
          "group": "2_anydiff@3"
        },
        {
          "command": "anydiff.compareSelectionWithSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "2_anydiff@4"
        },
        {
          "command": "anydiff.compareFileWithActive",
          "when": "editorTextFocus && !editorHasSelection",
          "group": "2_anydiff@5"
        },
        {
          "command": "anydiff.compareWithGitHead",
          "when": "editorTextFocus",
          "group": "2_anydiff@6"
        },
        {
          "command": "anydiff.compareGitRevisions",
          "when": "editorTextFocus",
          "group": "2_anydiff@7"
        }
      ],
      "explorer/context": [
        {
          "command": "anydiff.compareFileWithActive",
          "when": "!explorerResourceIsFolder && !explorerResourceMultiSelected",
          "group": "2_anydiff@1"
        },
        {
          "command": "anydiff.compareJsonSemantic",
          "when": "!explorerResourceIsFolder && !explorerResourceMultiSelected && resourceExtname =~ /\\.jsonc?$/",
          "group": "2_anydiff@2"
        },
        {
          "command": "anydiff.compareMultipleFiles",
          "when": "explorerResourceMultiSelected",
          "group": "2_anydiff@3"
        },
        {
          "command": "anydiff.compareFiles",
          "when": "!explorerResourceMultiSelected",
          "group": "2_anydiff@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "anydiff.compareSelectedWithClipboard",
        "key": "ctrl+k d",
        "mac": "cmd+k d",
        "when": "false"
      },
      {
        "command": "anydiff.compareSelectedWithFile",
        "key": "ctrl+k f",
        "mac": "cmd+k f",
        "when": "false"
      },
      {
        "command": "anydiff.compareSelectedWithInput",
        "key": "ctrl+k i",
        "mac": "cmd+k i",
        "when": "false"
      },
      {
        "command": "anydiff.compareSelectionWithSelection",
        "key": "ctrl+k s",
        "mac": "cmd+k s",
        "when": "false"
      },
      {
        "command": "anydiff.compareWithGitHead",
        "key": "ctrl+k g",
        "mac": "cmd+k g",
        "when": "false"
      },
      {
        "command": "anydiff.compareGitRevisions",
        "key": "ctrl+k r",
        "mac": "cmd+k r",
        "when": "false"
      },
      {
        "command": "anydiff.showRecent",
        "key": "ctrl+k h",
        "mac": "cmd+k h",
        "when": "false"
      }
    ],
    "configuration": {
      "title": "AnyDiff",
      "properties": {
        "anydiff.language": {
          "type": "string",
          "enum": ["auto", "en", "zh-cn"],
          "default": "auto",
          "markdownDescription": "%anydiff.language%"
        },
        "anydiff.ignoreTrimWhitespace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%anydiff.ignoreTrimWhitespace%"
        },
        "anydiff.ignoreAllWhitespace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%anydiff.ignoreAllWhitespace%"
        },
        "anydiff.ignoreCase": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%anydiff.ignoreCase%"
        },
        "anydiff.clipboardHistoryLimit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "%anydiff.clipboardHistoryLimit%"
        },
        "anydiff.maxFileSizeMB": {
          "type": "number",
          "default": 10,
          "markdownDescription": "%anydiff.maxFileSizeMB%"
        },
        "anydiff.showStatsNotification": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%anydiff.showStatsNotification%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "anydiff.gettingStarted",
        "title": "%anydiff.walkthrough.title%",
        "description": "%anydiff.walkthrough.description%",
        "steps": [
          {
            "id": "compare",
            "title": "%anydiff.walkthrough.compare.title%",
            "description": "%anydiff.walkthrough.compare.description%",
            "media": {
              "markdown": "media/walkthrough-compare.md"
            }
          },
          {
            "id": "selection",
            "title": "%anydiff.walkthrough.selection.title%",
            "description": "%anydiff.walkthrough.selection.description%",
            "media": {
              "markdown": "media/walkthrough-selection.md"
            }
          },
          {
            "id": "git",
            "title": "%anydiff.walkthrough.git.title%",
            "description": "%anydiff.walkthrough.git.description%",
            "media": {
              "markdown": "media/walkthrough-git.md"
            }
          },
          {
            "id": "panel",
            "title": "%anydiff.walkthrough.panel.title%",
            "description": "%anydiff.walkthrough.panel.description%",
            "media": {
              "markdown": "media/walkthrough-panel.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "vsix": "npm run package && npx @vscode/vsce package --no-dependencies",
    "verify:nls": "node scripts/verify-nls.cjs",
    "verify:i18n": "node scripts/check-i18n.cjs",
    "verify:e2e": "node scripts/e2e-smoke.cjs",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
